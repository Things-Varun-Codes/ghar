{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "ghar",
    "private": true,
    "license": "MIT",
    "engines": {
        "node": ">=22.12"
    },
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "dev-reset": "bash scripts/dev-reset.sh",
        "dev-setup": "bash scripts/dev-setup.sh",
        "format": "prettier --write resources/",
        "format:check": "prettier --check resources/",
        "lint": "eslint . --fix",
        "lint:check": "eslint .",
        "smoke": "node scripts/smoke.mjs",
        "smoke-loadmore": "npm run build && node scripts/loadmore-smoke.mjs",
        "smoke-mcp": "node scripts/smoke-mcp.mjs",
        "test": "vitest run",
        "test:rules": "node --test tools/eslint-rules/__tests__/*.test.js",
        "test:watch": "vitest",
        "types:check": "tsc --noEmit"
    },
    "devDependencies": {
        "@babel/core": "^7.29.13",
        "@eslint/js": "^10.0.1",
        "@inertiajs/vite": "^3.9.1",
        "@laravel/vite-plugin-wayfinder": "^0.1.11",
        "@rolldown/plugin-babel": "^0.3.1",
        "@sentry/vite-plugin": "^11.12.0",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@tailwindcss/vite": "^4.3.3",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/react": "^16.3.3",
        "@types/node": "^26.6.6",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.7",
        "@vitejs/plugin-react": "^6.3.0",
        "babel-plugin-react-compiler": "^1.0.0",
        "concurrently": "^10.0.6",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import-x": "^4.17.1",
        "eslint-plugin-react-hooks": "^7.0.0",
        "globals": "^17.14.0",
        "jsdom": "^31.0.0",
        "laravel-vite-plugin": "^3.2.0",
        "lefthook": "^2.1.9",
        "playwright": "^1.64.1",
        "prettier": "^3.10.1",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4.3.3",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.1",
        "vite": "^8.0.0",
        "vitest": "^5.0.5"
    },
    "dependencies": {
        "@inertiajs/core": "^3.9.1",
        "@inertiajs/react": "^3.9.1",
        "@radix-ui/react-alert-dialog": "^1.2.1",
        "@radix-ui/react-checkbox": "^1.4.1",
        "@radix-ui/react-dialog": "^1.3.1",
        "@radix-ui/react-dropdown-menu": "^2.2.1",
        "@radix-ui/react-popover": "^1.3.1",
        "@radix-ui/react-select": "^2.4.1",
        "@radix-ui/react-slot": "^1.5.0",
        "@radix-ui/react-switch": "^1.4.1",
        "@radix-ui/react-toggle": "^1.2.1",
        "@sentry/react": "^11.12.0",
        "@tiptap/core": "^3.32.0",
        "@tiptap/extension-link": "^3.32.0",
        "@tiptap/pm": "^3.32.0",
        "@tiptap/react": "^3.32.0",
        "@tiptap/starter-kit": "^3.32.0",
        "@vis.gl/react-google-maps": "^1.8.3",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-react": "^1.55.0",
        "photoswipe": "^5.4.4",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "sonner": "^2.0.0",
        "tailwind-merge": "^3.7.0",
        "tw-animate-css": "^1.4.0"
    },
    "overrides": {
        "minimatch": "^11.0.8"
    }
}
