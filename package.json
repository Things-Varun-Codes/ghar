{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "ghar",
    "private": true,
    "description": "A private, self-hosted family app for one household, with a shared timeline of photos and moments, lists the household keeps, and notes to each other.",
    "license": "MIT",
    "engines": {
        "node": ">=22.12"
    },
    "type": "module",
    "scripts": {
        "build": "vite build --logLevel warn",
        "dev": "vite",
        "dev-reset": "bash scripts/dev-reset.sh",
        "dev-setup": "bash scripts/dev-setup.sh",
        "dev-sync": "bash scripts/dev-sync.sh",
        "dev-up": "bash scripts/dev-sync.sh --serve",
        "icons": "node scripts/app-icons.mjs",
        "format": "prettier --write resources/",
        "format:check": "prettier --check resources/",
        "lint": "eslint . --fix",
        "lint:check": "eslint .",
        "release": "node scripts/release.mjs prepare",
        "release:notes": "node scripts/release.mjs notes",
        "release:tag": "node scripts/release.mjs tag",
        "smoke": "npm run build && playwright test -c scripts/smoke/smoke.config.mjs",
        "smoke-loadmore": "npm run build && playwright test -c scripts/smoke/loadmore.config.mjs",
        "smoke-mcp": "node scripts/smoke-mcp.mjs",
        "test": "vitest run",
        "test:rules": "node --test tools/eslint-rules/__tests__/*.test.js",
        "test:scripts": "node --test scripts/__tests__/*.test.mjs",
        "test:watch": "vitest",
        "types:check": "tsc --noEmit",
        "verify": "bash scripts/verify.sh"
    },
    "devDependencies": {
        "@babel/core": "^7.29.13",
        "@eslint/js": "^10.0.1",
        "@inertiajs/vite": "^3.9.1",
        "@laravel/vite-plugin-wayfinder": "^0.1.11",
        "@playwright/test": "^1.65.0",
        "@rolldown/plugin-babel": "^0.3.1",
        "@sentry/vite-plugin": "^11.12.0",
        "@stylistic/eslint-plugin": "^6.0.1",
        "@tailwindcss/vite": "^4.3.3",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/react": "^16.3.3",
        "@types/node": "^26.6.6",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.7",
        "@types/supercluster": "^7.1.3",
        "@vitejs/plugin-react": "^6.3.0",
        "babel-plugin-react-compiler": "^1.0.0",
        "concurrently": "^10.0.6",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import-x": "^4.17.1",
        "eslint-plugin-react-hooks": "^7.0.0",
        "globals": "^17.14.0",
        "jsdom": "^31.0.0",
        "laravel-vite-plugin": "^3.2.0",
        "lefthook": "^2.1.9",
        "prettier": "^3.10.1",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4.3.3",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.1",
        "vite": "^8.0.0",
        "vitest": "^5.0.5"
    },
    "dependencies": {
        "@base-ui/react": "^1.9.0",
        "@inertiajs/core": "^3.9.1",
        "@inertiajs/react": "^3.9.1",
        "@sentry/react": "^11.12.0",
        "@tanstack/react-virtual": "^3.14.26",
        "@tiptap/core": "^3.32.0",
        "@tiptap/extension-link": "^3.32.0",
        "@tiptap/pm": "^3.32.0",
        "@tiptap/react": "^3.32.0",
        "@tiptap/starter-kit": "^3.32.0",
        "@vis.gl/react-maplibre": "^8.1.3",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "lucide-react": "^1.55.0",
        "maplibre-gl": "^6.19.0",
        "motion": "^14.14.0",
        "photoswipe": "^5.4.4",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "react-easy-crop": "^6.2.5",
        "sonner": "^2.0.0",
        "supercluster": "^9.1.0",
        "tailwind-merge": "^3.7.0",
        "tw-animate-css": "^1.4.0",
        "usehooks-ts": "^3.1.1"
    },
    "overrides": {
        "minimatch": "^11.0.8"
    }
}
