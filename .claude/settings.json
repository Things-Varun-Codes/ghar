{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "permissions": {
        "allow": [
            "Bash(git status:*)",
            "Bash(git diff:*)",
            "Bash(git log:*)",
            "Bash(git show:*)",
            "Bash(git blame:*)",
            "Bash(git ls-files:*)",
            "Bash(git grep:*)",
            "Bash(gh pr view:*)",
            "Bash(gh pr diff:*)",
            "Bash(gh pr checks:*)",
            "Bash(gh run list:*)",
            "Bash(gh run view:*)",
            "Bash(npm test)",
            "Bash(npx vitest run:*)",
            "Bash(npm run test:rules)",
            "Bash(npm run types:check)",
            "Bash(npm run lint:check)",
            "Bash(npm run format:check)",
            "Bash(npm run smoke)",
            "Bash(npm run smoke-loadmore)",
            "Bash(npm run verify)",
            "Bash(npm audit --audit-level=high --omit=dev)",
            "Bash(npx prettier --check:*)",
            "Bash(npx tsc --noEmit:*)",
            "Bash(npx lefthook run pre-push:*)",
            "Bash(composer audit:*)",
            "Bash(composer show:*)",
            "Bash(npm ls:*)",
            "Bash(php artisan test:*)",
            "Bash(php artisan route:list:*)",
            "Bash(ghar-test:*)",
            "Bash(./vendor/bin/pint --test:*)",
            "Bash(vendor/bin/pint --test:*)",
            "Bash(./vendor/bin/phpstan analyse:*)",
            "Bash(vendor/bin/phpstan analyse:*)",
            "Bash(./scripts/check-boundaries.sh)",
            "Bash(./scripts/check-bare-catch.sh)",
            "Bash(./scripts/check-env-deploy-sync.sh)",
            "Bash(node scripts/check-smoke-routes.mjs)"
        ]
    }
}
