# Ghar self-host settings, read by docker-compose.selfhost.yml.
# Three lines are required; everything else is optional.

# ─── Required ────────────────────────────────────────────────────────
# The address people open. Use https:// once it's behind a TLS proxy.
APP_URL=http://localhost:8080
# Any long random string: `openssl rand -hex 24`.
DB_PASSWORD=
# The first admin, created on first start. Its password is printed once in
# `docker compose -f docker-compose.selfhost.yml logs app`.
GHAR_ADMIN_EMAIL=
GHAR_ADMIN_NAME=

# ─── Name ────────────────────────────────────────────────────────────
# Shown on the sign-in page, the sidebar, the browser tab, the installed app
# and in mail. Quote it if it has spaces.
# APP_NAME=Ghar

# ─── Image ───────────────────────────────────────────────────────────
# A major (1), minor (1.2) or exact (1.2.3) version. See CHANGELOG.md.
GHAR_VERSION=1
GHAR_PORT=8080
# A host folder for photos instead of the `media` volume, e.g. /srv/ghar/media.
# It must be writable by uid 82 (www-data in the image).
# GHAR_MEDIA_PATH=

# ─── Reverse proxy ───────────────────────────────────────────────────
# `private` trusts a proxy on this machine or Docker network. Add `cloudflare`
# if Cloudflare proxies your DNS. See DEPLOY.md.
TRUSTED_PROXIES=private

# ─── Mail (invites, password resets) ─────────────────────────────────
# `log` writes mail to the app log, fine for trying it out. For real use pick
# `smtp` (any provider) or `resend`.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# RESEND_API_KEY=

# ─── Media ───────────────────────────────────────────────────────────
# `local` keeps photos on this machine (private, signed links). `s3` uses a
# bucket: R2, B2, MinIO, Garage or AWS. Decide before uploading anything.
MEDIA_DISK=local
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=
# S3_ENDPOINT=
# S3_REGION=auto
# S3_USE_PATH_STYLE_ENDPOINT=true

# ─── Optional ────────────────────────────────────────────────────────
# Generated on first start and kept in the storage volume when empty.
# APP_KEY=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Location autocomplete in Our History. Without it you type the place yourself.
# GOOGLE_MAPS_API_KEY=

# AI flower pictures in Our Mailbox (Cloudflare Workers AI). `fake` uses a
# drawn placeholder.
BOUQUET_IMAGE_PROVIDER=fake
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_WORKERS_AI_TOKEN=

# Any Sentry-compatible error tracker.
# SENTRY_LARAVEL_DSN=
# SENTRY_BROWSER_DSN=
