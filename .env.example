# Ghar environment template.
#
# The values here run a local development copy; `npm run dev-setup` turns this
# file into your .env. For a real deployment set these in your host's
# environment settings instead and use the production notes below and in
# DEPLOY.md. Never commit real values.

# ─── App ──────────────────────────────────────────────────────────────
APP_NAME=Ghar
# Production: production
APP_ENV=local
# `npm run dev-setup` generates this. Production: `php artisan key:generate --show`.
APP_KEY=
# Production: false
APP_DEBUG=true
# The address you open in the browser. Production: your https:// URL.
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Who may set X-Forwarded-* headers: `private` (a reverse proxy on this host or
# Docker network), `cloudflare` (its edge ranges; also reads CF-Connecting-IP),
# IPs/CIDRs, or a comma-separated mix such as `cloudflare,private`.
TRUSTED_PROXIES=private

# The container creates this admin on its first start and prints the password
# once in its log. Locally `npm run dev-setup` seeds accounts instead.
GHAR_ADMIN_EMAIL=
GHAR_ADMIN_NAME=

# Production uses `stderr` (docker-compose.yml's default) so Docker rotates logs.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ─── Database: PostgreSQL ────────────────────────────────────────────
# These match the container in docker-compose.override.yml. In production
# DB_HOST is your Postgres server as seen from the app container, and the
# password is a strong random value.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ghar
DB_USERNAME=ghar
DB_PASSWORD=ghar

# ─── Sessions, cache, queue ──────────────────────────────────────────
SESSION_DRIVER=database
# 30 days in minutes so "Remember me" carries across browser restarts.
SESSION_LIFETIME=43200
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# `database` keeps the cache in Postgres. `redis` uses Valkey or Redis at
# REDIS_HOST and needs PHP's redis extension, which the production image has.
CACHE_STORE=database
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
# `sync` runs jobs inline, so local photo conversions need no worker.
# The production image always uses `database` with its own worker.
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# ─── Media ───────────────────────────────────────────────────────────
# `local` (the default) keeps photos and videos on this server, under
# storage/app/private, served through signed links that expire. `s3` uses the
# private bucket below instead. Both are private; pick one before real use,
# because switching later means moving every file.
MEDIA_DISK=local

# Any S3-compatible store (Cloudflare R2, Backblaze B2, MinIO, Garage, AWS S3),
# only read when MEDIA_DISK=s3. Leave S3_ENDPOINT empty for AWS. For R2 it is
# https://<account-id>.r2.cloudflarestorage.com (not a custom domain).
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_ENDPOINT=
# `auto` suits R2; AWS, B2 and MinIO want their real region (MinIO: us-east-1).
S3_REGION=auto
# true for R2, MinIO and Garage; false for AWS virtual-hosted buckets.
S3_USE_PATH_STYLE_ENDPOINT=true

# ─── Mail ────────────────────────────────────────────────────────────
# Locally everything lands in Mailpit (http://127.0.0.1:8025).
# Production: MAIL_MAILER=resend with RESEND_API_KEY and an address on a domain
# verified in Resend, or MAIL_MAILER=smtp with your provider's details.
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=
MAIL_FROM_ADDRESS=ghar@example.test
MAIL_FROM_NAME=Ghar
RESEND_API_KEY=

# ─── Error tracking (optional) ───────────────────────────────────────
# Any Sentry-compatible backend. Empty turns reporting off.
SENTRY_LARAVEL_DSN=
# The browser's DSN, read at runtime (often a separate project from the server's).
SENTRY_BROWSER_DSN=

# Sourcemap upload, build time only. Keep these out of the runtime environment.
# SENTRY_URL=https://sentry.example.com
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=your-org
# SENTRY_PROJECT=your-project

# ─── Telescope (local only) ──────────────────────────────────────────
# Only registered when APP_ENV=local. Set true to record requests.
TELESCOPE_ENABLED=false

# ─── Web Push ────────────────────────────────────────────────────────
# Generate with `php artisan webpush:vapid` (`npm run dev-setup` does it for
# you). Rotating them invalidates every existing subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A mailto: URL identifying who runs this instance.
VAPID_SUBJECT=mailto:dev@example.test

# ─── Google Maps (optional) ──────────────────────────────────────────
# Places autocomplete on Our History. A public key, read at runtime; restrict it
# by HTTP referrer. Empty disables the location field.
GOOGLE_MAPS_API_KEY=

# ─── AI bouquets (Our Mailbox) ───────────────────────────────────────
# `fake` returns a placeholder image with no API call.
# `cloudflare` uses Workers AI and needs the two values below.
BOUQUET_IMAGE_PROVIDER=fake
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_WORKERS_AI_TOKEN=
# Optional override.
CLOUDFLARE_AI_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
